{
  "name": "rift",
  "version": "0.8.0",
  "description": "A visual, AI-native code review workspace focused on branch diffs.",
  "license": "MIT",
  "main": "app-out/main/index.js",
  "type": "module",
  "bin": {
    "rift": "bin/rift.cjs"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts && npm run test:installer",
    "test:installer": "node --test tests/mac-preview-installer.test.cjs",
    "test:ui": "npm run build && playwright test",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && ngc -p src/renderer/tsconfig.app.json --noEmit",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "package:win": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "dev.wise.rift",
    "productName": "Rift",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "beforePack": "build/before-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "app-out/**/*",
      "package.json",
      "LICENSE",
      "version.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": "dir",
      "identity": null
    },
    "win": {
      "target": "dir"
    },
    "artifactName": "Rift-${version}-${arch}.${ext}"
  },
  "author": "Rift",
  "dependencies": {
    "@angular/common": "^21.2.21",
    "@angular/core": "^21.2.21",
    "@angular/platform-browser": "^21.2.21",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "node-pty": "1.1.0",
    "rxjs": "^7.8.2",
    "shiki": "^4.4.3",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/compiler": "^21.2.21",
    "@angular/compiler-cli": "^21.2.21",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.3.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tsx": "4.21.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
